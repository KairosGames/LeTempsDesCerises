[sub_resource type="GDScript" id="GDScript_ec114"]
resource_name = "FakeGameManager"
script/source = "extends Node

@export var canon: Canon
@export var barricade: Barricade
@export var disabled_covers: Array[Cover]


func _ready() -> void:
	canon.shoot.connect(_on_canon_shot, CONNECT_ONE_SHOT)

func _on_canon_shot() -> void:
	barricade.take_damage()
	for cover in disabled_covers: 
		cover.enabled = true
"

