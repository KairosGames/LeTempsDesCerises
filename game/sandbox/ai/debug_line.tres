code = "shader_type spatial;
render_mode blend_mix, unshaded;

void vertex() {
	COLOR.a = (TIME - INSTANCE_CUSTOM.r) / INSTANCE_CUSTOM.g;
}

void fragment() {
	ALBEDO = COLOR.rgb;
	ALPHA = max(0.0, 1.0 - COLOR.a);
}
