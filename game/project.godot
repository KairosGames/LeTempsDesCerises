; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Le Temps des Cerises"
config/version="0.1.0"
run/main_scene="uid://bqw181keq72d"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="uid://bft3a0yxj3of0"

[autoload]

WwiseRuntimeManager="*res://addons/Wwise/runtime/wwise_runtime_manager.gd"
BeehaveGlobalMetrics="*uid://c3ktl6ontsdt7"
BeehaveGlobalDebugger="*uid://bl3ma400hpvsh"
WwiseGlobal="*uid://cqwj72jqu08ab"
ShootDebug="*uid://cbks56no2f7ji"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/beehave/plugin.cfg", "res://addons/brackeys_particle_controls/plugin.cfg", "res://addons/cover_gizmo/plugin.cfg", "res://addons/custom_gizmo/plugin.cfg", "res://addons/mesh_combiner_3d/plugin.cfg", "res://addons/shoot_debug/plugin.cfg")

